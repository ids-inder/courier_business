# ============================================================================
# Courier Outreach — configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Every value below is something YOU provide once during setup.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. SENDING MAIL (SMTP)  — how the agent sends outreach + booking emails.
#    Use a DEDICATED address (e.g. sales@yourdomain.com), not your personal
#    inbox. For Gmail/Google Workspace use an App Password, not your login.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USERNAME=sales@yourdomain.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
# The visible "From" — what recipients see.
MAIL_FROM_NAME=Your Courier Co.
MAIL_FROM_ADDRESS=sales@yourdomain.com
# Where replies should go if different from the From address (optional).
MAIL_REPLY_TO=sales@yourdomain.com

# ---------------------------------------------------------------------------
# 2. READING MAIL (IMAP) — how the agent reads REPLIES.
#    PRIVACY RULE: the reader only ever processes messages whose sender is a
#    company we emailed. Everything else in the mailbox is ignored & never
#    stored. (See README > Privacy.)
# ---------------------------------------------------------------------------
IMAP_HOST=imap.yourprovider.com
IMAP_PORT=993
IMAP_USERNAME=sales@yourdomain.com
IMAP_PASSWORD=your-app-password
IMAP_MAILBOX=INBOX

# ---------------------------------------------------------------------------
# 3. CLAUDE API — the "brain": drafts personalised emails, classifies replies,
#    proposes meeting times. Get a key at console.anthropic.com.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# Model used for drafting/classification (small+cheap is plenty here).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# 4. GOOGLE — the Sheet (your cockpit) + Calendar (booking).
#    Create a service account, download its JSON, and SHARE the Sheet +
#    Calendar with the service account's email. Path is to that JSON file.
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/google_service_account.json
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_CALENDAR_ID=primary

# ---------------------------------------------------------------------------
# 5. YOUR BUSINESS — so the emails are real. Used in every message + signature.
# ---------------------------------------------------------------------------
BUSINESS_NAME=Your Courier & Cargo Co.
BUSINESS_SERVICES=Same-day & next-day courier, cargo, and B2B logistics
BUSINESS_COVERAGE=Chandigarh, Mohali, Panchkula (Tricity) and Baddi / BBN
BUSINESS_WEBSITE=https://yourdomain.com
BUSINESS_PHONE=+91-XXXXXXXXXX
SIGNATURE_NAME=Your Name
SIGNATURE_TITLE=Founder

# ---------------------------------------------------------------------------
# 6. BOOKING RULES — for the appointment-confirmation step.
# ---------------------------------------------------------------------------
TIMEZONE=Asia/Kolkata
# Days/hours you take meetings (24h clock, local time).
MEETING_DAYS=Mon,Tue,Wed,Thu,Fri
MEETING_HOURS_START=10:00
MEETING_HOURS_END=18:00
MEETING_DEFAULT_DURATION_MIN=30
# Minimum notice before a meeting can be booked (hours).
MEETING_MIN_NOTICE_HOURS=24

# ---------------------------------------------------------------------------
# 7. SENDING POLICY (deliverability) — the warm-up ramp. These are the knobs;
#    raise them as your domain reputation builds. See README > Deliverability.
# ---------------------------------------------------------------------------
# Emails allowed on day 1, and how many more each subsequent day, up to the cap.
WARMUP_START_PER_DAY=10
WARMUP_DAILY_INCREMENT=5
WARMUP_MAX_PER_DAY=40
# Only send during these local hours (spreads sends, looks human).
SEND_WINDOW_START=10:00
SEND_WINDOW_END=17:00
# Follow-up cadence (days after previous email with no reply). Empty = no follow-up.
FOLLOWUP_DAYS=3,7

# ---------------------------------------------------------------------------
# 8. THE APP — the mini "Approvals & Chat" console you confirm bookings in.
# ---------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8080
# A shared secret you set — required to log into the console.
APP_ACCESS_TOKEN=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# 9. RUNTIME
# ---------------------------------------------------------------------------
# full_auto = source+send within caps automatically.
# supervised = queue emails for your approval before sending.
RUN_MODE=full_auto
DATABASE_PATH=./data/courier_outreach.sqlite3
LOG_LEVEL=INFO
